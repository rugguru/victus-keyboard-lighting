+/* Board 8BBE's SSDT13 defines LC05 as the keyboard gate setter. Pass
+ * an explicit buffer so firmware receives the same type it expects.
+ * Do not infer success from LC04: that byte may retain Fn-key state. */
+static int hp_kbd_backlight_gate(bool enabled)
+{
+	u8 data[128] = { 0 };
+	union acpi_object argument;
+	struct acpi_object_list args = { .count = 1, .pointer = &argument };
+	struct acpi_buffer output = { ACPI_ALLOCATE_BUFFER, NULL };
+	acpi_status status;
+	int ret;
+
+	if (hp_victus_kbd_ec_supported())
+		return hp_victus_kbd_ec_gate(enabled);
+
+	data[0] = enabled ? HPWMI_BACKLIGHT_SET_ON_QUERY : HPWMI_BACKLIGHT_SET_OFF_QUERY;
+	ret = hp_wmi_perform_query(HPWMI_BACKLIGHT_BRIGHTNESS_SET_QUERY,
+				   HPWMI_BACKLIGHT, data, sizeof(data), sizeof(u32));
+	if (!dmi_match(DMI_BOARD_NAME, "8BBE"))
+		return ret;
+	data[0] = enabled ? HPWMI_BACKLIGHT_SET_ON_QUERY : HPWMI_BACKLIGHT_SET_OFF_QUERY;
+	argument.type = ACPI_TYPE_BUFFER;
+	argument.buffer.length = sizeof(data);
+	argument.buffer.pointer = data;
+	status = acpi_evaluate_object(NULL, "\\_SB.WMID.LC05", &args, &output);
+	kfree(output.pointer);
+	return ACPI_SUCCESS(status) ? 0 : ret;
 }
 
