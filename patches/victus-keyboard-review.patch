+static ssize_t keyboard_backlight_state_show(struct device *dev,
+                                            struct device_attribute *attr,
+                                            char *buf)
+{
+    u8 data = 0;
+    int ret;
+    if (hp_victus_kbd_ec_supported()) {
+        ret = hp_victus_kbd_ec_gate(-1);
+        return ret < 0 ? ret : sysfs_emit(buf, "%u\n", ret ? 228 : 100);
