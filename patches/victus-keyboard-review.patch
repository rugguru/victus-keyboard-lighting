 static bool hp_kbd_backlight_is_on(void)
 {
 	u8 data = 0;
 	int ret;
 
+	if (hp_victus_kbd_ec_supported())
+		return hp_victus_kbd_ec_gate(-1) > 0;
+
 	ret = hp_wmi_perform_query(HPWMI_BACKLIGHT_BRIGHTNESS_GET_QUERY, HPWMI_BACKLIGHT, &data,
